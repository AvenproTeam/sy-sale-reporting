<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="so_report_hide_price_sale_order_portal_content" inherit_id="sale.sale_order_portal_content">

        <xpath expr="//th[@id='product_qty_header']/following-sibling::th[1]" position="attributes">
            <attribute name="t-if">sale_order.has_show_price_report_lines</attribute>
        </xpath>

        <xpath expr="//th[@t-if='display_discount']" position="attributes">
            <attribute name="t-if">display_discount and sale_order.has_show_price_report_lines</attribute>
        </xpath>

        <xpath expr="//th[@id='taxes_header']" position="attributes">
            <attribute name="t-if">sale_order.has_show_price_report_lines or not sale_order.hide_tax_information</attribute>
        </xpath>

        <xpath expr="//th[@id='subtotal_header']" position="attributes">
            <attribute name="t-if">sale_order.has_show_price_report_lines</attribute>
        </xpath>

        <xpath expr="//td[div[@t-field='line.price_unit']]" position="attributes">
            <attribute name="t-if">sale_order.has_show_price_report_lines</attribute>
        </xpath>

        <xpath expr="//tbody//td[@t-if='display_discount']" position="attributes">
            <attribute name="t-if">display_discount and sale_order.has_show_price_report_lines</attribute>
        </xpath>

        <xpath expr="//td[span[contains(@t-out, 'line.tax_id')]]" position="attributes">
            <attribute name="t-if">sale_order.has_show_price_report_lines or not sale_order.hide_tax_information</attribute>
        </xpath>

        <xpath expr="//td[span[contains(@class, 'oe_order_line_price_subtotal')]]" position="attributes">
            <attribute name="t-if">sale_order.has_show_price_report_lines</attribute>
        </xpath>

        <xpath expr="//div[@t-field='line.price_unit']" position="attributes">
            <attribute name="t-if">line.discount &gt;= 0 and line.show_price_info_report</attribute>
        </xpath>

        <xpath expr="//div[@t-field='line.price_reduce_taxexcl']" position="attributes">
            <attribute name="t-if">line.discount &lt; 0 and line.show_price_info_report</attribute>
        </xpath>

        <xpath expr="//tbody//td[@t-if='display_discount']/strong" position="attributes">
            <attribute name="t-if">line.discount &gt; 0 and line.show_price_info_report</attribute>
        </xpath>

        <xpath expr="//td[span[contains(@t-out, 'line.tax_id')]]/span" position="attributes">
            <attribute name="t-if">line.show_price_info_report or not sale_order.hide_tax_information</attribute>
        </xpath>

        <xpath expr="//td[span[contains(@class, 'oe_order_line_price_subtotal')]]/span" position="attributes">
            <attribute name="t-if">line.show_price_info_report</attribute>
        </xpath>

    </template>
</odoo>
