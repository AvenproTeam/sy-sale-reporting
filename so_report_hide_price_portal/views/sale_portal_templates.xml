<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="so_report_hide_price_sale_order_portal_content"
        inherit_id="sale.sale_order_portal_content"
    >
        <xpath expr="//th[@name='th_priceunit']" position="attributes">
            <attribute name="t-if">sale_order.has_show_price_report_lines</attribute>
        </xpath>
        <xpath expr="//th[@t-if='display_discount']" position="attributes">
            <attribute name="t-if">display_discount and sale_order.has_show_price_report_lines</attribute>
        </xpath>
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="t-if">sale_order.has_show_price_report_lines or not sale_order.hide_tax_information</attribute>
        </xpath>
        <xpath expr="//th[@name='th_subtotal']" position="attributes">
            <attribute name="t-if">sale_order.has_show_price_report_lines</attribute>
        </xpath>

        <xpath expr="//td[@name='td_priceunit']" position="attributes">
            <attribute name="t-if">sale_order.has_show_price_report_lines</attribute>
        </xpath>
        <xpath expr="//td[@name='td_priceunit']//span[@t-field='line.price_unit']" position="attributes">
            <attribute name="t-if">line.show_price_info_report</attribute>
        </xpath>

        <xpath expr="//td[@t-if='display_discount']" position="attributes">
            <attribute name="t-if">display_discount and sale_order.has_show_price_report_lines</attribute>
        </xpath>
        <xpath expr="//td[@t-if='display_discount']//span[@t-field='line.discount']" position="attributes">
            <attribute name="t-if">line.show_price_info_report</attribute>
        </xpath>

        <xpath expr="//td[@name='td_taxes']" position="attributes">
            <attribute name="t-if">sale_order.has_show_price_report_lines or not sale_order.hide_tax_information</attribute>
        </xpath>
        <xpath expr="//td[@name='td_taxes']//span" position="attributes">
            <attribute name="t-if">line.show_price_info_report or not sale_order.hide_tax_information</attribute>
        </xpath>

        <xpath expr="//td[@name='td_subtotal']" position="attributes">
            <attribute name="t-if">sale_order.has_show_price_report_lines</attribute>
        </xpath>
        <xpath expr="//span[@t-field='line.price_subtotal']" position="attributes">
            <attribute name="t-if">line.show_price_info_report</attribute>
        </xpath>
        <xpath expr="//span[@t-field='line.price_total']" position="attributes">
            <attribute name="t-if">line.show_price_info_report</attribute>
        </xpath>
    </template>
</odoo>
